# API Key de Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=tu_api_key_aqui

# (Opcional) Modelo de texto/análisis. Cámbialo si el que viene por defecto no está
# disponible en tu cuenta. Ejecuta `node list-models.js` para ver los modelos que
# tu API key tiene habilitados.
GEMINI_MODEL=gemini-3.1-pro-preview

# (Opcional) Modelo de generación de imágenes (Nano Banana / Gemini Image).
# Se usa cuando pulsas "Generar imagen" en la app.
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
